# AU SMS — scam. Lures drawn from patterns already covered by __tests__ and
# from the 2026-08 threat-intel sweeps, so labels are safe by construction.
{"id": "au-sms-0001", "type": "sms", "region": "AU", "content": "AusPost: your parcel is held at customs. Pay the outstanding import duty to release your parcel: http://auspost-clearance.cyou/pay", "label": "scam", "category": "parcel-delivery", "source": "fixture:scamDetector.test.ts", "addedAt": "2026-08-29"}
{"id": "au-sms-0002", "type": "sms", "region": "AU", "content": "URGENT: your AusPost parcel is held. Confirm identity at https://auspost-track.shop/verify", "label": "scam", "category": "parcel-delivery", "source": "fixture:scamDetector.test.ts", "addedAt": "2026-08-29"}
{"id": "au-sms-0003", "type": "sms", "region": "AU", "content": "AusPost: we could not deliver your parcel, the address is incomplete. Update your house number at https://auspost-redelivery.bond/address", "label": "scam", "category": "parcel-delivery", "source": "handwritten", "addedAt": "2026-08-29", "notes": "address-correction lure, PR #220"}
{"id": "au-sms-0004", "type": "sms", "region": "AU", "content": "myGov: your tax has been recalculated. Confirm here: https://mygov-refund.xyz", "label": "scam", "category": "tax-refund", "source": "fixture:scamDetector.test.ts", "addedAt": "2026-08-29"}
{"id": "au-sms-0005", "type": "sms", "region": "AU", "content": "ATO: your tax refund is waiting, verify now at http://ato-refund.xyz", "label": "scam", "category": "tax-refund", "source": "fixture:scamDetectorRegion.test.ts", "addedAt": "2026-08-29"}
{"id": "au-sms-0006", "type": "sms", "region": "AU", "content": "myGovID verification required. Confirm your identity at http://mygovid-verify.top", "label": "scam", "category": "identity-verification", "source": "fixture:scamDetector.test.ts", "addedAt": "2026-08-29"}
{"id": "au-sms-0007", "type": "sms", "region": "AU", "content": "Your digital identity verification has expired. Re-verify now to keep your myGov access.", "label": "scam", "category": "identity-verification", "source": "fixture:scamDetector.test.ts", "addedAt": "2026-08-29"}
{"id": "au-sms-0008", "type": "sms", "region": "AU", "content": "Linkt: pay your outstanding toll at https://linkt-pay.example", "label": "scam", "category": "toll", "source": "fixture:scamDetector.test.ts", "addedAt": "2026-08-29"}
{"id": "au-sms-0009", "type": "sms", "region": "AU", "content": "Linkt: you have an unpaid toll of $12.40. Pay now to avoid a fine.", "label": "scam", "category": "toll", "source": "fixture:scamDetector.test.ts", "addedAt": "2026-08-29"}
{"id": "au-sms-0010", "type": "sms", "region": "AU", "content": "Hi Mum, I dropped my phone in the sink and this is my new number. Can you transfer $850 to this account today? I will pay you back.", "label": "scam", "category": "voice-clone", "source": "handwritten", "addedAt": "2026-08-29"}
{"id": "au-sms-0011", "type": "sms", "region": "AU", "content": "Login at commbank-secure-login.tk/auth to restore access to your suspended account.", "label": "scam", "category": "bank-impersonation", "source": "fixture:bareHostname.test.ts", "addedAt": "2026-08-29", "notes": "schemeless host; exercises bare-hostname extraction"}
{"id": "au-sms-0012", "type": "sms", "region": "AU", "content": "Scan the QR code to verify your myGov account", "label": "scam", "category": "identity-verification", "source": "fixture:scamDetector.test.ts", "addedAt": "2026-08-29"}

# AU SMS — benign. Deliberately adversarial: same brands, same transactional
# register, same shape of call-to-action as the scam set. A benign set of
# "coffee tomorrow?" would make the FPR number meaningless.
{"id": "au-sms-0013", "type": "sms", "region": "AU", "content": "AusPost: your parcel has been delivered to your nominated safe place. Track at https://auspost.com.au/mypost/track", "label": "scam", "category": "parcel-delivery", "source": "handwritten", "addedAt": "2026-08-29", "notes": "Reads as an ordinary delivery notice; the link is what makes it a scam (post-2024 AU no-link policy). Originally mislabelled benign by the author."}
{"id": "au-sms-1002", "type": "sms", "region": "AU", "content": "AusPost: your parcel is on board for delivery today between 9am and 5pm. No action needed.", "label": "benign", "category": "parcel-delivery", "source": "handwritten", "addedAt": "2026-08-29"}
{"id": "au-sms-1003", "type": "sms", "region": "AU", "content": "Your myGov Inbox has a new message. Sign in at my.gov.au to read it.", "label": "benign", "category": "identity-verification", "source": "handwritten", "addedAt": "2026-08-29"}
{"id": "au-sms-1004", "type": "sms", "region": "AU", "content": "Linkt: your account balance is low. Top up at linkt.com.au or in the Linkt app.", "label": "benign", "category": "toll", "source": "handwritten", "addedAt": "2026-08-29"}
{"id": "au-sms-1005", "type": "sms", "region": "AU", "content": "Your appointment at the Medicare service centre is confirmed for Tuesday 3 September at 10:15am.", "label": "benign", "category": "government", "source": "handwritten", "addedAt": "2026-08-29"}
{"id": "au-sms-1006", "type": "sms", "region": "AU", "content": "Hi, it's Sam from the plumbing job on Thursday. Running about 20 minutes late, see you soon.", "label": "benign", "source": "handwritten", "addedAt": "2026-08-29"}
{"id": "au-sms-1007", "type": "sms", "region": "AU", "content": "Hey, are we still on for coffee tomorrow morning?", "label": "benign", "source": "fixture:coverage.test.ts", "addedAt": "2026-08-29"}
{"id": "au-sms-1008", "type": "sms", "region": "AU", "content": "Your prescription is ready for collection at the pharmacy. Opening hours 8am-7pm.", "label": "benign", "source": "handwritten", "addedAt": "2026-08-29"}
{"id": "au-sms-0014", "type": "sms", "region": "AU", "content": "---------- Forwarded message ----------\nFrom: Unknown\nSubject: Fwd: hi\n\nHi Mum, I dropped my phone in the sink and this is my new number. Can you transfer $850 today?", "label": "scam", "category": "family-impersonation", "source": "handwritten", "addedAt": "2026-09-02", "notes": "The script as it actually arrives at a checker: forwarded. Scored safe (0) before the opener anchor learned to see past forwarding scaffolding."}
{"id": "au-sms-1009", "type": "sms", "region": "AU", "content": "Dad said he'd lend me 500 for the car, I'll pay you back when I get my new number sorted.", "label": "benign", "category": "family-impersonation", "source": "handwritten", "addedAt": "2026-09-02", "notes": "Relation term as sentence subject, not addressee. Scored likely_scam (45) before the anchor distinguished the two."}
